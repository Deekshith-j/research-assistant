# Copy this file to `.env` and fill in your own values. Never commit `.env`.

# --- Generation model: Groq (free tier, no card needed) -----------------------
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=
# Strong model: Analyst + Verifier. Fast model: Coordinator + Memory Agent, and fallback.
GROQ_MAIN_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
LLM_MAX_RETRIES=4
LLM_TIMEOUT_S=60

# --- LangSmith tracing (free developer plan) ----------------------------------
# Create a key at https://smith.langchain.com -> Settings -> API Keys
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=asterline-research-assistant
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # only for EU-region accounts

# --- Local retrieval (no account needed) --------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RETRIEVAL_TOP_K=8

# --- Memory / history ----------------------------------------------------------
HISTORY_TURNS=6
MAX_MEMORIES_IN_CONTEXT=12
